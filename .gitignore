# ==============================================================================
# Git Ignore - Dashboard GH Archive
# ==============================================================================

# Entornos virtuales
.venv/
venv/
env/
ENV/

# Datasets y archivos pesados
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.json.gz
*.gz
*.zip
*.tar
*.parquet

# Caché de Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Archivos temporales de sistema e IDEs
.DS_Store
Thumbs.db
*.tmp
*.log
.vscode/
.idea/

